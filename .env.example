NODE_ENV=development
PORT=4000
DATABASE_PROVIDER=memory
JWT_SECRET=
CORS_ORIGIN=*
APP_PUBLIC_URL=http://localhost:4000
EMAIL_PROVIDER=development
EMAIL_FROM=no-reply@switchride.local
IDENTITY_PROVIDER=manual
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
FACE_LIVENESS_THRESHOLD=90
FACE_MATCH_SIMILARITY_THRESHOLD=90
FACE_CONSENT_VERSION=face-check-v1

# Auto-cancel ride requests not accepted within this many minutes
RIDE_REQUEST_TIMEOUT_MINUTES=5

# Optional phone OTP: SMS_PROVIDER=twilio plus server-side Twilio credentials
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
