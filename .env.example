NODE_ENV=development
PORT=4000
DATABASE_PROVIDER=memory
JWT_SECRET=
CORS_ORIGINS=http://localhost:5173,https://switchride-driver-app.vercel.app,https://switchride-rider-app-sihq.vercel.app
APP_PUBLIC_URL=http://localhost:4000
EMAIL_PROVIDER=development
EMAIL_FROM=no-reply@switchride.local
# Defaults to required in production. Set false only for a temporary migration window.
EMAIL_VERIFICATION_REQUIRED=false
# Defaults to required in production. Keep enabled and enroll every admin account.
ADMIN_MFA_REQUIRED=false
IDENTITY_PROVIDER=manual
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
FACE_LIVENESS_THRESHOLD=90
FACE_MATCH_SIMILARITY_THRESHOLD=90
FACE_CONSENT_VERSION=face-check-v1

# Auto-cancel ride requests not accepted within this many minutes
RIDE_REQUEST_TIMEOUT_MINUTES=5

# Optional phone OTP: SMS_PROVIDER=twilio plus server-side Twilio credentials
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
