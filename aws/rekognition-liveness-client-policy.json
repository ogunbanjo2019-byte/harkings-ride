{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SwitchRideLivenessStreamingOnly",
      "Effect": "Allow",
      "Action": [
        "rekognition:StartFaceLivenessSession"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    }
  ]
}
