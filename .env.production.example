
NODE_ENV=production
DATABASE_PROVIDER=supabase
PORT=4000
JWT_SECRET=
CORS_ORIGIN=https://drivers.example.com
APP_PUBLIC_URL=https://api.example.com
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SENSITIVE_STORAGE_BUCKET=sensitive-documents
EMAIL_PROVIDER=resend
EMAIL_FROM=SwitchRide <no-reply@example.com>
RESEND_API_KEY=
IDENTITY_PROVIDER=aws-rekognition
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
FACE_LIVENESS_THRESHOLD=90
FACE_MATCH_SIMILARITY_THRESHOLD=90
FACE_CONSENT_VERSION=face-check-v1
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=https://drivers.example.com/payment-return

# Auto-cancel ride requests not accepted within this many minutes
RIDE_REQUEST_TIMEOUT_MINUTES=5

# Optional phone OTP: SMS_PROVIDER=twilio plus server-side Twilio credentials
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
